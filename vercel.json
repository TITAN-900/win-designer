{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/projects/:slug/", "destination": "/project.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "win-designer.vercel.app" }],
      "destination": "https://win-joinery.vercel.app/",
      "permanent": true
    },
    {
      "source": "/projects/:slug/",
      "has": [{ "type": "host", "value": "win-designer.vercel.app" }],
      "destination": "https://win-joinery.vercel.app/projects/:slug/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "win-designer.vercel.app" }],
      "destination": "https://win-joinery.vercel.app/:path*",
      "permanent": true
    },
    { "source": "/about.html", "destination": "/#portfolio", "permanent": true },
    { "source": "/about", "destination": "/#portfolio", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/lighting/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
